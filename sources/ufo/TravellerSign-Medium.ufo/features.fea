    sub zero by zero.tf;
    sub one by one.tf;
    sub two by two.tf;
    sub three by three.tf;
    sub four by four.tf;
    sub five by five.tf;
    sub six by six.tf;
    sub seven by seven.tf;
    sub eight by eight.tf;
    sub nine by nine.tf;
} tnum;

feature pnum {
    sub zero.tf by zero;
    sub one.tf by one;
    sub two.tf by two;
    sub three.tf by three;
    sub four.tf by four;
    sub five.tf by five;
    sub six.tf by six;
    sub seven.tf by seven;
    sub eight.tf by eight;
    sub nine.tf by nine;
} pnum;

lookup SourceSignCaron {
    pos base uni1EB9
        <anchor anchor01141> mark @SourceSignCaronClass;
    pos base uni1ECD
        <anchor anchor01142> mark @SourceSignCaronClass;
} SourceSignCaron;

feature mark {
    lookup SourceSignCaron;
} mark;

lookup SourceSignAcuteGrave {
    pos base oti.uni1ECB.dotless
        <anchor anchor01143> mark @SourceSignAcuteGraveClass;
    pos base uni1EE5
        <anchor anchor01144> mark @SourceSignAcuteGraveClass;
} SourceSignAcuteGrave;

feature mark {
    lookup SourceSignAcuteGrave;
} mark;

feature ccmp {
    sub uni1ECB' [gravecomb acutecomb] by oti.uni1ECB.dotless;
} ccmp;

lookup SourceSignXDot {
    pos base x
        <anchor anchor01145> mark @SourceSignXDotClass;
} SourceSignXDot;

feature mark {
    lookup SourceSignXDot;
} mark;

