          <real>29.47697165523197</real>
          <key>attachmentRule</key>
          <string>Shift the reviewed standalone psili incoming x roles by the compound ink-centre shift, centring the full pair with the same optical relation. Retain incoming y. Derive one extra-stack receiver from the native acute ink-relative receiver.</string>
          <key>horizontalRule</key>
          <string>Translate the unchanged native acute to the right until its sampled horizontal ink gap equals the same-cut native psili-and-oxia control.</string>
          <key>incomingAnchorHorizontalShift</key>
          <real>149.55555555555554</real>
          <key>verticalRule</key>
          <string>Align the two actual ink-bound centres vertically without scaling either component.</string>
        </dict>
